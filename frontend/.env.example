# Copy to frontend/.env.local if you need to override defaults. No secrets belong here:
# every VITE_* value is bundled into the public JavaScript.

# Base URL for API calls. Default "/api" uses the Vite dev proxy below (no CORS needed).
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
