# Copy to backend/.env and adjust. Never commit a .env file with real values.

ENVIRONMENT=development
API_PREFIX=/api

# PostgreSQL (recommended). For a quick local run without Postgres you can use:
# DATABASE_URL=sqlite:///./stocksense.db
DATABASE_URL=postgresql+psycopg://stocksense:stocksense@localhost:5432/stocksense

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OTP password reset
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10

# Roles a new user may choose at signup (comma-separated).
SIGNUP_ALLOWED_ROLES=INVENTORY_MANAGER,WAREHOUSE_STAFF

# Requests per minute per client IP on login/signup/OTP endpoints.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Email delivery. "console" = DEVELOPMENT ONLY (OTP is printed to the backend log).
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=StockSense <no-reply@stocksense.local>
EMAIL_USE_TLS=true
